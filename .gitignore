# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# derived icons — generated from design/favicon/*.svg by scripts/build-icons.mjs
# on every dev/build, so the binary never drifts from the drawing
/src/app/apple-icon.png
__pycache__/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the template. It holds names only, never values — see the comment at
# the top of the file. Without this negation `.env*` swallows it and the
# variables in the README have nothing to be copied from.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
