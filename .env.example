# Copy to `.env` and fill in. Names only in this file — never commit a value.
#
# None of these are needed to build: the database connects on first use rather
# than at import, so `next build` succeeds without any of them and a
# misconfigured deploy fails per-request naming the variable it wants.

# The shared Turso database. Every table this site owns is namespaced `coffee_`.
# A `file:` URL works locally and needs no token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The admin password, checked with a timing-safe compare at /login. Unset means
# admin login is disabled — the app warns once and refuses every attempt rather
# than throwing.
ADMIN_KEY=

# Absolute origin, used for metadataBase and the canonical URL. NEXT_PUBLIC_ is
# inlined at BUILD time, so setting this only in the runtime environment has no
# effect — it has to be present when `next build` runs. Falls back to
# https://coffee.justin06lee.dev.
NEXT_PUBLIC_SITE_URL=
